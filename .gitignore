# =============================================================================
# Claude on Rails Review - Runtime State Files
# =============================================================================
# These are created during hook execution and should never be committed.
# As of 3.0.0 all of them live in <hooks_dir>/state/.
/state/
.claude/hooks/state/
# Pre-3.0.0 locations (files written next to the hook)
stop-hook-state-*.json
review-results-*.json
review-prompt-*.md
coordinator-instructions-*.json
stop-hook-debug.log
stop-hook-metrics.jsonl

